{
  "name": "todo-categorias",
  "version": "1.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "cordova:prepare": "ng build && cordova prepare",
    "android:run": "ng build && cordova run android",
    "android:build": "ng build && cordova build android --debug",
    "android:release": "ng build && cordova build android --release -- --packageType=apk",
    "ios:emulate": "ng build && cordova emulate ios",
    "ios:run": "ng build && cordova run ios",
    "ios:build": "ng build && cordova build ios",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ionic/angular": "^9.0.9",
    "ionicons": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "21.2.27",
    "@angular-devkit/schematics": "21.2.27",
    "@angular/build": "21.2.27",
    "@angular/cdk": "^21.2.14",
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/cli": "^7.2.1",
    "@playwright/test": "1.64.1",
    "@schematics/angular": "21.2.27",
    "cordova": "^13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-ios": "^8.1.1",
    "cordova-plugin-firebasex-config": "^2.0.2",
    "cordova-plugin-firebasex-core": "^2.0.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "description": "To-Do List con categorías (Ionic + Angular + Cordova + Firebase Remote Config)",
  "cordova": {
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": {
      "cordova-plugin-firebasex-core": {
        "ANDROID_FIREBASE_CORE_VERSION": "21.1.1",
        "ANDROID_FIREBASE_INSTALLATIONS_VERSION": "19.1.0",
        "ANDROID_GSON_VERSION": "2.14.0",
        "IOS_FIREBASE_SDK_VERSION": "12.14.0"
      },
      "cordova-plugin-firebasex-config": {
        "ANDROID_FIREBASE_CONFIG_VERSION": "23.1.0",
        "IOS_FIREBASE_SDK_VERSION": "12.14.0"
      }
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
